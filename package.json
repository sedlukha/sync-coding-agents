{
  "name": "sync-coding-agents",
  "version": "0.1.1",
  "description": "Sync .agents/ (single source of truth) into .claude/ and .github/ so Claude Code and GitHub Copilot pick up the same agent and skill definitions.",
  "keywords": [
    "claude",
    "claude-code",
    "github-copilot",
    "agents",
    "skills",
    "ai",
    "sync",
    "symlinks",
    "cli"
  ],
  "license": "MIT",
  "author": "sedlukha",
  "homepage": "https://github.com/sedlukha/sync-coding-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedlukha/sync-coding-agents.git"
  },
  "bugs": {
    "url": "https://github.com/sedlukha/sync-coding-agents/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sync-coding-agents": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/post-build.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.2",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@10.27.0"
}
